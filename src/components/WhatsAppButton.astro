---
import { WHATSAPP_URL, PHONE_DISPLAY } from "../data/site";
---

<!-- Lives outside the React island: fixed, never touched by scroll transforms. -->
<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener"
  aria-label={`Pedir por WhatsApp al ${PHONE_DISPLAY}`}
  class="fixed z-50 flex min-h-14 items-center gap-2.5 rounded-full bg-whatsapp py-3 pl-4 pr-5 font-semibold text-ink shadow-[0_12px_30px_-8px_rgba(0,0,0,.45)] transition-transform duration-150 hover:scale-105 active:scale-95"
  style="right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom));"
>
  <svg aria-hidden="true" viewBox="0 0 32 32" class="size-7 shrink-0" fill="currentColor">
    <path d="M16.04 3C9.41 3 4.03 8.37 4.03 15c0 2.12.56 4.18 1.61 6L4 28l7.2-1.6A12 12 0 0 0 16.04 27C22.66 27 28 21.63 28 15S22.66 3 16.04 3Zm0 21.8c-1.8 0-3.56-.48-5.1-1.4l-.37-.22-4.27.95.96-4.15-.24-.39a9.79 9.79 0 0 1-1.5-5.2c0-5.42 4.42-9.83 9.84-9.83 5.41 0 9.8 4.41 9.8 9.83 0 5.43-4.4 9.82-9.8 9.82Zm5.38-7.36c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/>
  </svg>
  <span>Pedí por WhatsApp</span>
</a>
